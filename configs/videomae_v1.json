{
  "model_id": "MCG-NJU/videomae-base-finetuned-kinetics",
  "frames": 16,
  "model_fps": 8,
  "label": "label_B",
  "micro_batch": 8,
  "grad_accum": 2,
  "val_batch": 16,
  "num_workers": 4,
  "lru_size": 8,
  "amp": "bf16",
  "optimizer": "AdamW",
  "betas": [0.9, 0.999],
  "weight_decay": 0.05,
  "base_lr": 5e-4,
  "lr_scaling": "base_lr * effective_batch / 256",
  "layer_decay": 0.7,
  "warmup_fraction": 0.05,
  "schedule": "cosine to 0",
  "max_epochs": 10,
  "grad_clip": 1.0,
  "drop_path": 0.2,
  "pos_weight": "auto",
  "type_weight": {"scheme": "sqrt_inverse_frequency", "clip": [0.5, 5.0], "normalise_mean": 1.0},
  "augmentation": "standard",
  "hflip_p": 0.5,
  "cctv_aug": {
    "p": 0.5,
    "fps_drop": [4, 5, 6],
    "blur_sigma": [0.3, 1.5],
    "downscale": [0.30, 0.70],
    "brightness": [0.5, 1.3],
    "contrast": [0.7, 1.3],
    "saturation": [0.6, 1.3],
    "hue": 0.02,
    "grayscale_p": 0.1,
    "jpeg_quality": [15, 40]
  },
  "monitor": "val_T_1",
  "patience": 3,
  "min_delta": 0.002,
  "step_ckpt_every": 500,
  "log_every": 50,
  "smooth_window": 3,
  "confidence_exclude": 2,
  "gpu_pause_temp_c": 85,
  "gpu_resume_temp_c": 70
}
